0fb5","html_url":"https://github.com/torvalds/linux/commit/9f4fc18bf285f20c1498f8fcfb586fa70a070fb5"}],"stats":{"total":5,"additions":4,"deletions":1},"files":[{"sha":"f1a0bab920a5580a507932974a86f96c08113759","filename":"net/xfrm/xfrm_policy.c","status":"modified","additions":4,"deletions":1,"changes":5,"blob_url":"https://github.com/torvalds/linux/blob/f85daf0e725358be78dfd208dea5fd665d8cb901/net%2Fxfrm%2Fxfrm_policy.c","raw_url":"https://github.com/torvalds/linux/raw/f85daf0e725358be78dfd208dea5fd665d8cb901/net%2Fxfrm%2Fxfrm_policy.c","contents_url":"https://api.github.com/repos/torvalds/linux/contents/net%2Fxfrm%2Fxfrm_policy.c?ref=f85daf0e725358be78dfd208dea5fd665d8cb901","patch":"@@ -2678,8 +2678,10 @@ static int xfrm_expand_policies(const struct flowi *fl, u16 family,\n \t\t*num_xfrms = 0;\n \t\treturn 0;\n \t}\n-\tif (IS_ERR(pols[0]))\n+\tif (IS_ERR(pols[0])) {\n+\t\t*num_pols = 0;\n \t\treturn PTR_ERR(pols[0]);\n+\t}\n \n \t*num_xfrms = pols[0]->xfrm_nr;\n \n@@ -2694,6 +2696,7 @@ static int xfrm_expand_policies(const struct flowi *fl, u16 family,\n \t\tif (pols[1]) {\n \t\t\tif (IS_ERR(pols[1])) {\n \t\t\t\txfrm_pols_put(pols, *num_pols);\n+\t\t\t\t*num_pols = 0;\n \t\t\t\treturn PTR_ERR(pols[1]);\n \t\t\t}\n \t\t\t(*num_pols)++;"}]}