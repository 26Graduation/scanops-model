hub.com/users/kuba-moo/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"332fdf951df8b870e3da86b122ae304e2aabe88c","url":"https://api.github.com/repos/torvalds/linux/commits/332fdf951df8b870e3da86b122ae304e2aabe88c","html_url":"https://github.com/torvalds/linux/commit/332fdf951df8b870e3da86b122ae304e2aabe88c"}],"stats":{"total":2,"additions":1,"deletions":1},"files":[{"sha":"c7503fd6491593fc749b9af182c646a39ed2ddbc","filename":"net/sctp/sm_make_chunk.c","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/torvalds/linux/blob/a2d859e3fc97e79d907761550dbc03ff1b36479c/net%2Fsctp%2Fsm_make_chunk.c","raw_url":"https://github.com/torvalds/linux/raw/a2d859e3fc97e79d907761550dbc03ff1b36479c/net%2Fsctp%2Fsm_make_chunk.c","contents_url":"https://api.github.com/repos/torvalds/linux/contents/net%2Fsctp%2Fsm_make_chunk.c?ref=a2d859e3fc97e79d907761550dbc03ff1b36479c","patch":"@@ -3697,7 +3697,7 @@ struct sctp_chunk *sctp_make_strreset_req(\n \toutlen = (sizeof(outreq) + stream_len) * out;\n \tinlen = (sizeof(inreq) + stream_len) * in;\n \n-\tretval = sctp_make_reconf(asoc, outlen + inlen);\n+\tretval = sctp_make_reconf(asoc, SCTP_PAD4(outlen) + SCTP_PAD4(inlen));\n \tif (!retval)\n \t\treturn NULL;\n "}]}