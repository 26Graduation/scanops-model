{"sha":"c57f9dcf1934a9ab0cd67650f2dea18cb0902270","node_id":"MDY6Q29tbWl0NDUzNzUwODpjNTdmOWRjZjE5MzRhOWFiMGNkNjc2NTBmMmRlYTE4Y2IwOTAyMjcw","commit":{"author":{"name":"Jehan","email":"jehan@girinstud.io","date":"2017-12-21T11:25:32Z"},"committer":{"name":"Jehan","email":"jehan@girinstud.io","date":"2017-12-21T11:29:24Z"},"message":"Bug 790784 - (CVE-2017-17784) heap overread in gbr parser / load_image.\n\nWe were assuming the input name was well formed, hence was\nnul-terminated. As any data coming from external input, this has to be\nthorougly checked.\nSimilar to commit 06d24a79af94837d615d0024916bb95a01bf3c59 but adapted\nto older gimp-2-8 code.","tree":{"sha":"20e471c3391dae0159493c6556cff50e78de7108","url":"https://api.github.com/repos/GNOME/gimp/git/trees/20e471c3391dae0159493c6556cff50e78de7108"},"url":"https://api.github.com/repos/GNOME/gimp/git/commits/c57f9dcf1934a9ab0cd67650f2dea18cb0902270","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/GNOME/gimp/commits/c57f9dcf1934a9ab0cd67650f2dea18cb0902270","html_url":"https://github.com/GNOME/gimp/commit/c57f9dcf1934a9ab0cd67650f2dea18cb0902270","comments_url":"https://api.github.com/repos/GNOME/gimp/commits/c57f9dcf1934a9ab0cd67650f2dea18cb0902270/comments","author":null,"committer":null,"parents":[{"sha":"decab3bfe7366fb91f9b4f1716d90e021274ea43","url":"https://api.github.com/repos/GNOME/gimp/commits/decab3bfe7366fb91f9b4f1716d90e021274ea43","html_url":"https://github.com/GNOME/gimp/commit/decab3bfe7366fb91f9b4f1716d90e021274ea43"}],"stats":{"total":3,"additions":2,"deletions":1},"files":[{"sha":"d3f01d9c560997de6eca42aa7fbff7f30d827f55","filename":"plug-ins/common/file-gbr.c","status":"modified","additions":2,"deletions":1,"changes":3,"blob_url":"https://github.com/GNOME/gimp/blob/c57f9dcf1934a9ab0cd67650f2dea18cb0902270/plug-ins%2Fcommon%2Ffile-gbr.c","raw_url":"https://github.com/GNOME/gimp/raw/c57f9dcf1934a9ab0cd67650f2dea18cb0902270/plug-ins%2Fcommon%2Ffile-gbr.c","contents_url":"https://api.github.com/repos/GNOME/gimp/contents/plug-ins%2Fcommon%2Ffile-gbr.c?ref=c57f9dcf1934a9ab0cd67650f2dea18cb0902270","patch":"@@ -443,7 +443,8 @@ load_image (const gchar  *filename,\n     {\n       gchar *temp = g_new (gchar, bn_size);\n \n-      if ((read (fd, temp, bn_size)) < bn_size)\n+      if ((read (fd, temp, bn_size)) < bn_size ||\n+          temp[bn_size - 1] != '\\0')\n         {\n           g_set_error (error, G_FILE_ERROR, G_FILE_ERROR_FAILED,\n                        _(\"Error in GIMP brush file '%s'\"),"}]}