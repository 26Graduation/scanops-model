{"sha":"450da26a76286a8342ec0864b3d113856709f8f6","node_id":"MDY6Q29tbWl0MjYxNzE4NTg4OjQ1MGRhMjZhNzYyODZhODM0MmVjMDg2NGIzZDExMzg1NjcwOWY4ZjY=","commit":{"author":{"name":"Julian Smith","email":"jules@op59.net","date":"2019-10-28T14:37:48Z"},"committer":{"name":"Julian Smith","email":"jules@op59.net","date":"2019-10-28T15:37:55Z"},"message":"Bug 701785: fixed sanitizer heap-buffer-overflow in lprn_is_black().\n\nIn contrib/lips4/gdevlprn.c:lprn_is_black(), it seems that bpl is not\nnecessarily a multiple of lprn->nBw, so we need to explicitly avoid straying\ninto the next line's data.\n\nThis also avoids accessing beyond our buffer if we are already on the last\nline, and so fixes the sanitizer error.\n\nFixes:\n    ./sanbin/gs -sOutputFile=tmp -sDEVICE=lips2p ../bug-701785.pdf","tree":{"sha":"689379d487113dc73173267f3c14001ff2422551","url":"https://api.github.com/repos/ArtifexSoftware/ghostpdl/git/trees/689379d487113dc73173267f3c14001ff2422551"},"url":"https://api.github.com/repos/ArtifexSoftware/ghostpdl/git/commits/450da26a76286a8342ec0864b3d113856709f8f6","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/ArtifexSoftware/ghostpdl/commits/450da26a76286a8342ec0864b3d113856709f8f6","html_url":"https://github.com/ArtifexSoftware/ghostpdl/commit/450da26a76286a8342ec0864b3d113856709f8f6","comments_url":"https://api.github.com/repos/ArtifexSoftware/ghostpdl/commits/450da26a76286a8342ec0864b3d113856709f8f6/comments","author":{"login":"cgdae","id":59938474,"node_id":"MDQ6VXNlcjU5OTM4NDc0","avatar_url":"https://avatars.githubusercontent.com/u/59938474?v=4","gravatar_id":"","url":"https://api.github.com/users/cgdae","html_url":"https://github.com/cgdae","followers_url":"https://api.github.com/users/cgdae/followers","following_url":"https://api.github.com/users/cgdae/following{/other_user}","gists_url":"https://api.github.com/users/cgdae/gists{/gist_id}","starred_url":"https://api.github.com/users/cgdae/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cgdae/subscriptions","organizations_url":"https://api.github.com/users/cgdae/orgs","repos_url":"https://api.github.com/users/cgdae/repos","events_url":"https://api.github.com/users/cgdae/events{/privacy}","received_events_url":"https://api.github.com/users/cgdae/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"cgdae","id":59938474,"node_id":"MDQ6VXNlcjU5OTM4NDc0","avatar_url":"https://avatars.githubusercontent.com/u/59938474?v=4","gravatar_id":"","url":"https://api.github.com/users/cgdae","html_url":"https://github.com/cgdae","followers_url":"https://api.github.com/users/cgdae/followers","following_url":"https://api.github.com/users/cgdae/following{/other_user}","gists_url":"https://api.github.com/users/cgdae/gists{/gist_id}","starred_url":"https://api.github.com/users/cgdae/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/cgdae/subscriptions","organizations_url":"https://api.github.com/users/cgdae/orgs","repos_url":"https://api.github.com/users/cgdae/repos","events_url":"https://api.github.com/users/cgdae/events{/privacy}","received_events_url":"https://api.github.com/users/cgdae/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"93cb0c0adbd9bcfefd021d59c472388f67d3300d","url":"https://api.github.com/repos/ArtifexSoftware/ghostpdl/commits/93cb0c0adbd9bcfefd021d59c472388f67d3300d","html_url":"https://github.com/ArtifexSoftware/ghostpdl/commit/93cb0c0adbd9bcfefd021d59c472388f67d3300d"}],"stats":{"total":9,"additions":8,"deletions":1},"files":[{"sha":"7461e46e4618457153f6742ce7e0fca75ebfa22f","filename":"contrib/lips4/gdevlprn.c","status":"modified","additions":8,"deletions":1,"changes":9,"blob_url":"https://github.com/ArtifexSoftware/ghostpdl/blob/450da26a76286a8342ec0864b3d113856709f8f6/contrib%2Flips4%2Fgdevlprn.c","raw_url":"https://github.com/ArtifexSoftware/ghostpdl/raw/450da26a76286a8342ec0864b3d113856709f8f6/contrib%2Flips4%2Fgdevlprn.c","contents_url":"https://api.github.com/repos/ArtifexSoftware/ghostpdl/contents/contrib%2Flips4%2Fgdevlprn.c?ref=450da26a76286a8342ec0864b3d113856709f8f6","patch":"@@ -334,9 +334,16 @@ lprn_is_black(gx_device_printer * pdev, int r, int h, int bx)\n     y0 = (r + h - bh) % maxY;\n     for (y = 0; y < bh; y++) {\n         p = &lprn->ImageBuf[(y0 + y) * bpl + bx * lprn->nBw];\n-        for (x = 0; x < lprn->nBw; x++)\n+        for (x = 0; x < lprn->nBw; x++) {\n+            /* bpl isn't necessarily a multiple of lprn->nBw, so\n+            we need to explicitly stop after the last byte in this\n+            line to avoid accessing either the next line's data or\n+            going off the end of our buffer completely. This avoids\n+            https://bugs.ghostscript.com/show_bug.cgi?id=701785. */\n+            if (bx * lprn->nBw + x >= bpl)  break;\n             if (p[x] != 0)\n                 return 1;\n+        }\n     }\n     return 0;\n }"}]}