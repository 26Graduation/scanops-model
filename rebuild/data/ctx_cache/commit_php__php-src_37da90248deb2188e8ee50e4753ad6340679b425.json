xt;\n \t} else {\n \t\tx = 1 << k;\n \t\trv = (Bigint *)MALLOC(sizeof(Bigint) + (x-1)*sizeof(Long));\n+\t\tif (!rv) {\n+\t\t\t_THREAD_PRIVATE_MUTEX_UNLOCK(dtoa_mutex);\n+\t\t\tzend_error(E_ERROR, \"Balloc() failed to allocate memory\");\n+\t\t}\n \t\trv->k = k;\n \t\trv->maxwds = x;\n \t}"}]}